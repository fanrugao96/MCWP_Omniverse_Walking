def "Simulation"
{
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 981
        uniform token physxScene:broadphaseType = "MBP"
        bool physxScene:enableGPUDynamics = 0
        uniform token physxScene:solverType = "TGS"
    }

    def DomeLight "FillLight"
    {
        float inputs:intensity = 1400
    }

    def Camera "Camera" (
        apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
    )
    {
        float2 clippingRange = (1, 100000)
        float exposure:fStop = 5
        float exposure:iso = 100
        float exposure:responsivity = 1.1026709
        float exposure:time = 0.02
        float focalLength = 31.176914
        float horizontalAperture = 36
        bool omni:rtx:autoExposure:enabled = 0
        bool omni:rtx:autoExposure:histogramClamping:enabled = 0
        float verticalAperture = 20.25
        matrix4d xformOp:transform = ( (0.999996561604223, -0.0026223614798908585, 0, 0), (0.0016144869375467822, 0.6156593584378415, 0.7880107536067218, 0), (-0.0020664490459980337, -0.7880080441138745, 0.6156614753256582, 0), (46.33616772017667, -1396.5951884982476, 1367.0231992374524, 0.9999999999999998) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def Sphere "ValidationProbe" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
        bool physics:kinematicEnabled = 1
        float physics:mass = 0.5
        bool physxRigidBody:enableCCD = 0
        color3f[] primvars:displayColor = [(1, 0.32, 0.02)]
        double radius = 10
        double3 xformOp:translate = (150, 0, 162.91666666666538)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "DesktopHandProxy"
    {
        color3f[] primvars:displayColor = [(0.1, 0.65, 1)]
        double radius = 6
        token visibility = "invisible"
        double3 xformOp:translate = (250, 0, 300)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "RecordedUEController"
    {
        token visibility = "invisible"
        matrix4d xformOp:transform
        uniform token[] xformOpOrder = ["xformOp:transform"]

        def BasisCurves "X"
        {
            int[] curveVertexCounts = [2]
            point3f[] points = [(0, 0, 0), (12, 0, 0)]
            color3f[] primvars:displayColor = [(1, 0.1, 0.1)]
            uniform token type = "linear"
            float[] widths = [1.5] (
                interpolation = "constant"
            )
        }

        def BasisCurves "Y"
        {
            int[] curveVertexCounts = [2]
            point3f[] points = [(0, 0, 0), (0, 12, 0)]
            color3f[] primvars:displayColor = [(0.1, 1, 0.1)]
            uniform token type = "linear"
            float[] widths = [1.5] (
                interpolation = "constant"
            )
        }

        def BasisCurves "Z"
        {
            int[] curveVertexCounts = [2]
            point3f[] points = [(0, 0, 0), (0, 0, 12)]
            color3f[] primvars:displayColor = [(0.1, 0.3, 1)]
            uniform token type = "linear"
            float[] widths = [1.5] (
                interpolation = "constant"
            )
        }
    }
}

over "OmniverseKit_Persp" (
    prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
    customData = {
        dictionary omni = {
            dictionary kit = {
                bool hide_in_stage_window = 1
                bool no_delete = 1
            }
        }
    }
    hide_in_stage_window = true
    kind = "component"
    no_delete = true
)
{
    float2 clippingRange = (1, 10000000)
    float exposure:fStop = 5
    float exposure:responsivity = 1.1026709
    float exposure:time = 0.02
    float focalLength = 18.147562
    float focusDistance = 400
    custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -11187.526139622263)
    float3 xformOp:rotateXYZ = (54.73561, -6.3611094e-15, 135)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (6489.121279666156, 6459.121312250254, 6659.571072855534)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
}

