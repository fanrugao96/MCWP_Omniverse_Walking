#usda 1.0
(
    defaultPrim = "M_Basic_Floor"
    upAxis = "Z"
)

def Material "M_Basic_Floor" (
    assetInfo = {
        asset identifier = @./M_Basic_Floor.usda@
        string name = "M_Basic_Floor"
    }
)
{
    token outputs:surface.connect = </M_Basic_Floor/SurfaceShader.outputs:surface>

    def Shader "SurfaceShader"
    {
        uniform token info:id = "UsdPreviewSurface"
        float inputs:ambientOcclusion = 1
        float inputs:anisotropy = 0
        color3f inputs:diffuseColor = (0.25818285, 0.31854677, 0.38132602)
        float inputs:metallic = 0.49803925
        float inputs:roughness = 0.49803925
        float inputs:specular = 0.49803925
        token outputs:surface
    }
}

