#usda 1.0
(
    defaultPrim = "M2_Green_Edge_Dark"
    upAxis = "Z"
)

def Material "M2_Green_Edge_Dark" (
    assetInfo = {
        asset identifier = @./M2_Green_Edge_Dark.usda@
        string name = "M2_Green_Edge_Dark"
    }
)
{
    token outputs:surface.connect = </M2_Green_Edge_Dark/SurfaceShader.outputs:surface>

    def Shader "SurfaceShader"
    {
        uniform token info:id = "UsdPreviewSurface"
        float inputs:ambientOcclusion = 1
        float inputs:anisotropy = 0
        color3f inputs:diffuseColor = (0.012286488, 0.104616486, 0.049706567)
        float inputs:metallic = 0
        float inputs:roughness = 0.49803925
        float inputs:specular = 0.49803925
        token outputs:surface
    }
}

