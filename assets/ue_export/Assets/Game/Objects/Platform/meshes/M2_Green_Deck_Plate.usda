#usda 1.0
(
    defaultPrim = "M2_Green_Deck_Plate"
    upAxis = "Z"
)

def Material "M2_Green_Deck_Plate" (
    assetInfo = {
        asset identifier = @./M2_Green_Deck_Plate.usda@
        string name = "M2_Green_Deck_Plate"
    }
)
{
    token outputs:surface.connect = </M2_Green_Deck_Plate/SurfaceShader.outputs:surface>

    def Shader "SurfaceShader"
    {
        uniform token info:id = "UsdPreviewSurface"
        float inputs:ambientOcclusion = 1
        float inputs:anisotropy = 0
        color3f inputs:diffuseColor = (0.008023193, 0.072271846, 0.029556833)
        float inputs:metallic = 0
        float inputs:roughness = 0.49803925
        float inputs:specular = 0.49803925
        token outputs:surface
    }
}

