#usda 1.0
(
    defaultPrim = "M2_Painted_Industrial_Green"
    upAxis = "Z"
)

def Material "M2_Painted_Industrial_Green" (
    assetInfo = {
        asset identifier = @./M2_Painted_Industrial_Green.usda@
        string name = "M2_Painted_Industrial_Green"
    }
)
{
    token outputs:surface.connect = </M2_Painted_Industrial_Green/SurfaceShader.outputs:surface>

    def Shader "SurfaceShader"
    {
        uniform token info:id = "UsdPreviewSurface"
        float inputs:ambientOcclusion = 1
        float inputs:anisotropy = 0
        color3f inputs:diffuseColor = (0.0047769533, 0.099898726, 0.035601314)
        float inputs:metallic = 0
        float inputs:roughness = 0.49803925
        float inputs:specular = 0.49803925
        token outputs:surface
    }
}

