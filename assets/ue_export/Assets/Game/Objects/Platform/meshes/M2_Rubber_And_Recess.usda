#usda 1.0
(
    defaultPrim = "M2_Rubber_And_Recess"
    upAxis = "Z"
)

def Material "M2_Rubber_And_Recess" (
    assetInfo = {
        asset identifier = @./M2_Rubber_And_Recess.usda@
        string name = "M2_Rubber_And_Recess"
    }
)
{
    token outputs:surface.connect = </M2_Rubber_And_Recess/SurfaceShader.outputs:surface>

    def Shader "SurfaceShader"
    {
        uniform token info:id = "UsdPreviewSurface"
        float inputs:ambientOcclusion = 1
        float inputs:anisotropy = 0
        color3f inputs:diffuseColor = (0.022173885, 0.026241222, 0.02842604)
        float inputs:metallic = 0
        float inputs:roughness = 0.49803925
        float inputs:specular = 0.49803925
        token outputs:surface
    }
}

