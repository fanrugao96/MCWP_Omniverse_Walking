#usda 1.0
(
    defaultPrim = "M2_Galvanized_Steel"
    upAxis = "Z"
)

def Material "M2_Galvanized_Steel" (
    assetInfo = {
        asset identifier = @./M2_Galvanized_Steel.usda@
        string name = "M2_Galvanized_Steel"
    }
)
{
    token outputs:surface.connect = </M2_Galvanized_Steel/SurfaceShader.outputs:surface>

    def Shader "SurfaceShader"
    {
        uniform token info:id = "UsdPreviewSurface"
        float inputs:ambientOcclusion = 1
        float inputs:anisotropy = 0
        color3f inputs:diffuseColor = (0.31854677, 0.38132602, 0.40197778)
        float inputs:metallic = 0
        float inputs:roughness = 0.49803925
        float inputs:specular = 0.49803925
        token outputs:surface
    }
}

